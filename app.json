{
  "expo": {
    "name": "Kan",
    "slug": "kan",
    "version": "1.24.40",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kan",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kan.story"
    },
    "android": {
      "package": "com.kan.story",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "edgeToEdgeEnabled": true
    },
    "androidStatusBar": {
      "backgroundColor": "#050505",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#050505",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Kan \u2014 Interactive Naruto RPG",
      "shortName": "Kan",
      "lang": "en",
      "scope": "/",
      "startUrl": "/",
      "themeColor": "#050505",
      "backgroundColor": "#050505",
      "description": "A single-page PWA where you play Kan, an original shinobi in the Naruto universe.",
      "display": "standalone",
      "orientation": "portrait",
      "barStyle": "black-translucent"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/images/icon.png",
          "imageWidth": 144,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}